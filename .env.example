# ===================================
# Supabase Configuration
# ===================================
# Get these values from: `supabase start` output
# Local development uses http://127.0.0.1:54321

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Production: Replace with Supabase Cloud values
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_cloud_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_cloud_service_role_key

# ===================================
# AI Service Configuration (Phase 8)
# ===================================
# LangChain agent service URL
# Local: http://localhost:2024 (langgraph dev)
# Production: Your LangSmith deployment URL

NEXT_PUBLIC_AGENT_API_URL=http://localhost:2024

# ===================================
# LLM Provider API Keys
# ===================================
# Required for AI agent functionality
# Get keys from: https://platform.openai.com/ or https://console.anthropic.com/

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================================
# LangSmith Configuration (Optional)
# ===================================
# For production deployment and monitoring
# Get from: https://smith.langchain.com/

LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=your_project_name

# ===================================
# Application Configuration
# ===================================
NODE_ENV=development

# ===================================
# Setup Instructions
# ===================================
# 1. Copy this file:
#    - For Next.js: cp .env.example nextjs_/.env.local
#    - For LangChain: cp .env.example langchain_/.env
#
# 2. Start Supabase to get credentials:
#    cd supabase_ && supabase start
#
# 3. Update NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
#    with output from supabase start
#
# 4. Add your LLM provider API keys (OpenAI or Anthropic)
#
# 5. (Optional) Add LangSmith key for production deployment
#
# 6. Never commit .env or .env.local files to git!
